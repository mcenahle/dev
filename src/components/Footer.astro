---
import { Icon } from "astro-icon/components";
---

<footer class="usa-footer">
  <div class="usa-footer__primary-section">
    <nav class="usa-footer__nav" aria-label="Footer navigation">
      <ul class="grid-row grid-gap">
        <li
          class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content"
        >
          <a
            class="usa-footer__primary-link"
            href="https://github.com"
            target="_blank">GitHub <Icon name="mdi:open-in-new" /></a
          >
        </li>
        <li
          class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content"
        >
          <a
            class="usa-footer__primary-link"
            href="https://developer.mozilla.org/zh-CN/"
            target="_blank">mozilla 开发者 <Icon name="mdi:open-in-new" /></a
          >
        </li>
        <li
          class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content"
        >
          <a
            class="usa-footer__primary-link"
            href="https://linux.do"
            target="_blank">Linux.do <Icon name="mdi:open-in-new" /></a
          >
        </li>
        <li
          class="mobile-lg:grid-col-4 desktop:grid-col-auto usa-footer__primary-content"
        >
          <a
            class="usa-footer__primary-link"
            href="https://mcenahle.dev"
            target="_blank">现行 dev 网站 <Icon name="mdi:open-in-new" /></a
          >
        </li>
      </ul>
    </nav>
  </div>
  <div class="usa-footer__secondary-section">
    <div class="grid-container">
      <div class="grid-row grid-gap">
        <div
          class="usa-footer__logo grid-row mobile-lg:grid-col-6 mobile-lg:grid-gap-2"
        >
          <div class="mobile-lg:grid-col-auto">
            <img
              class="usa-footer__logo-img"
              src="https://mcenahle.dev/favicon.ico"
              alt=""
            />
          </div>
          <div class="mobile-lg:grid-col-auto">
            <p class="usa-footer__logo-heading">usdws.mcenahle.dev</p>
          </div>
        </div>
        <div class="usa-footer__contact-links mobile-lg:grid-col-6">
          <div class="usa-footer__social-links grid-row grid-gap-1">
            <div class="grid-col-auto">
              <a
                class="usa-social-link"
                href="https://github.com/mcenahle/"
                target="_blank"
                ><img
                  class="usa-social-link__icon"
                  src="/images/github.svg"
                  alt="GitHub"
                /></a
              >
            </div>
          </div>
          <p class="usa-footer__contact-heading" style="font-size: 16px;">
            居住地：上海市崇明区/浦东新区
          </p>
          <address class="usa-footer__address">
            <div class="usa-footer__contact-info grid-row grid-gap">
              <div class="grid-col-auto">
                <a
                  href="mailto:2867155965@qq.com"
                  class="usa-link usa-link--external">2867155965@qq.com</a
                >
              </div>
              <div class="grid-col-auto">
                <a
                  href="mailto:hi@mcenahle.page"
                  class="usa-link usa-link--external">hi@mcenahle.page</a
                >
              </div>
            </div>
          </address>
        </div>
      </div>
    </div>
  </div>
</footer>
