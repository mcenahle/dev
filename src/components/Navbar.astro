---
import { Icon } from "astro-icon/components";
---

<meta charset="utf-8" />

<nav
  class="navbar navbar-default navbar-fixed-top"
  role="navigation"
  data-pagefind-ignore
>
  <div class="container-fluid">
    <div class="navbar-header">
      <button
        type="button"
        class="navbar-toggle"
        data-toggle="collapse"
        data-target="#example-navbar-collapse"
      >
        <span class="sr-only">切换导航</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
      <a class="navbar-brand" href="/">mcenahle.dev</a>
    </div>
    <div class="collapse navbar-collapse" id="example-navbar-collapse">
      <ul class="nav navbar-nav">
        <li class="dropdown">
          <a
            href="javascript:void(0)"
            class="dropdown-toggle"
            data-toggle="dropdown"
          >
            <Icon name="mdi:design" /> 作品展示 <b class="caret"></b>
          </a>
          <ul class="dropdown-menu">
            <li>
              <a href="/projects/blender/"
                ><Icon name="mdi:blender-software" /> 建模作品展示</a
              >
            </li>
            <li>
              <a href="/projects/illustrator/"
                ><Icon name="mdi:palette" /> 矢量图作品展示</a
              >
            </li>
          </ul>
        </li>
        <li class="dropdown">
          <a
            href="javascript:void(0)"
            class="dropdown-toggle"
            data-toggle="dropdown"
          >
            <Icon name="mdi:head-thinking" /> 网站建设 <b class="caret"></b>
          </a>
          <ul class="dropdown-menu">
            <li>
              <a href="/staticization/"
                ><Icon name="mdi:language-html5" /> 静态化</a
              >
            </li>
            <li>
              <a href="/posts/"
                ><Icon name="mdi:post-it-note-check-outline" /> 开发博客</a
              >
            </li>
            <li>
              <a href="/ecosystem/"
                ><Icon name="mdi:web-check" /> 个人网站生态</a
              >
            </li>
          </ul>
        </li>
        <li>
          <a href="/signature/"><Icon name="mdi:key-chain-variant" /> SSH Key</a
          >
        </li>
        <li>
          <a href="https://mail.mcenahle.dev" target="_blank"
            ><Icon name="mdi:email" /> Webmail</a
          >
        </li>
      </ul>
      <ul class="nav navbar-nav navbar-right">
        <li>
          <a
            href="https://mcenahle.dev/gh/dev/"
            target="_blank"
            class="btn btn-default"
            style="margin: 8px 10px 8px 10px; padding: 6px 6px 6px 6px;"
            role="button"
            ><Icon name="mdi:github" /> 查看本网站的 GitHub 源代码
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>
