---
import Layout from "../../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const POSTS_PER_PAGE = 10;

const allPosts = Object.values(
  import.meta.glob("../*.md", { eager: true }),
).sort(
  (a: any, b: any) =>
    new Date(b.frontmatter.pubDate).getTime() -
    new Date(a.frontmatter.pubDate).getTime(),
);

const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);

export function getStaticPaths() {
  const POSTS_PER_PAGE = 10;

  const allPosts = Object.values(import.meta.glob("../*.md", { eager: true }));

  const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: {
      page: String(i + 2),
    },
  }));
}

const currentPage = Number(Astro.params.page);

const posts = allPosts.slice(
  (currentPage - 1) * POSTS_PER_PAGE,
  currentPage * POSTS_PER_PAGE,
);
---

<Layout>
  <h2>开发博客</h2>

  <p class="usa-intro">mcenahle.dev 开发博客</p>

  <ul class="usa-collection">
    {
      posts.map((post: any) => (
        <li class="usa-collection__item">
          <div class="usa-collection__body">
            <h3 class="usa-collection__heading">
              <a
                class="usa-link"
                href={post.url}
                aria-label={`${post.frontmatter.title}，打开文章`}
                title={post.frontmatter.title}
              >
                {post.frontmatter.title}
              </a>
            </h3>

            <p class="usa-collection__description">
              {post.frontmatter.description}
            </p>

            <ul class="usa-collection__meta" aria-label="文章信息">
              <li class="usa-collection__meta-item">
                <Icon name="mdi:account-edit" />
                &nbsp;
                <span>{post.frontmatter.author}</span>
              </li>

              <li class="usa-collection__meta-item">
                <Icon name="mdi:calendar" />
                &nbsp;
                <time datetime={post.frontmatter.pubDate}>
                  {post.frontmatter.pubDate}
                </time>
              </li>
            </ul>
          </div>
        </li>
      ))
    }
  </ul>

  <nav class="usa-pagination" aria-label="分页">
    <ul class="usa-pagination__list">
      {
        currentPage > 1 && (
          <li class="usa-pagination__item usa-pagination__arrow">
            <a
              href={
                currentPage === 2
                  ? "/posts/"
                  : `/posts/page/${currentPage - 1}/`
              }
              class="usa-pagination__link usa-pagination__previous-page"
              aria-label="上一页"
            >
              <span class="usa-pagination__link-text">上一页</span>
            </a>
          </li>
        )
      }

      {
        Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
          <li class="usa-pagination__item usa-pagination__page-no">
            <a
              href={page === 1 ? "/posts/" : `/posts/page/${page}/`}
              class:list={[
                "usa-pagination__button",
                { "usa-current": page === currentPage },
              ]}
              aria-current={page === currentPage ? "page" : undefined}
              aria-label={`第 ${page} 页`}
            >
              {page}
            </a>
          </li>
        ))
      }

      {
        currentPage < totalPages && (
          <li class="usa-pagination__item usa-pagination__arrow">
            <a
              href={`/posts/page/${currentPage + 1}/`}
              class="usa-pagination__link usa-pagination__next-page"
              aria-label="下一页"
            >
              <span class="usa-pagination__link-text">下一页</span>
            </a>
          </li>
        )
      }
    </ul>
  </nav>
</Layout>
