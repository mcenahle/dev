---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
const { frontmatter } = Astro.props;
---

<meta charset="utf-8" />
<Layout>
  <div class="usa-section" style="padding-top: 2rem; padding-bottom: 0rem;">
    <div class="grid-container">
      <div class="grid-row grid-gap">
        <div
          class="usa-layout-docs__sidenav display-none desktop:display-block desktop:grid-col-3"
        >
          <nav aria-label="Secondary navigation">
            <ul class="usa-sidenav" style="text-indent: 0em;">
              <li class="usa-sidenav__item">
                <a href="/">主页</a>
              </li>
              <li class="usa-sidenav__item">
                <a href="/site-affairs-documents/" class="usa-current"
                  >站务文件</a
                >
                <ul class="usa-sidenav__sublist">
                  <li class="usa-sidenav__item">
                    <a href="javascript:void(0);" class="usa-current"
                      >{frontmatter.title}</a
                    >
                  </li>
                </ul>
              </li>
            </ul>
          </nav>
        </div>
        <main class="desktop:grid-col-9 usa-prose" id="main-content">
          <h2 style="text-align: center; font-size: 30px;">
            {frontmatter.title}
          </h2>
          <h4 style="text-align: center; font-size: 20px;">
            <Icon name="mdi:format-list-numbered" />&nbsp;
            {frontmatter.no}
          </h4>

          <div class="affairs-docs-title-divider">
            <span></span>
          </div>

          <div class="post-meta">
            <span>
              <Icon name="mdi:account-edit" />
              {frontmatter.author}
            </span>

            <span>
              <Icon name="mdi:calendar" />
              {frontmatter.pubDate}
            </span>
            <div
              class="usa-prose posts"
              style="font-family:'FangSong_GB2312'; text-indent: 2em; margin-top: 10px;"
            >
              <slot />
            </div>
          </div>
        </main>
      </div>
      <div class="usa-layout-docs__sidenav desktop:display-none">
        <nav aria-label="Secondary navigation">
          <ul class="usa-sidenav" style="text-indent: 0em;">
            <li class="usa-sidenav__item">
              <a href="/">主页</a>
            </li>
            <li class="usa-sidenav__item">
              <a href="/site-affairs-documents/" class="usa-current">站务文件</a
              >
              <ul class="usa-sidenav__sublist">
                <li class="usa-sidenav__item">
                  <a href="javascript:void(0);" class="usa-current"
                    >{frontmatter.title}</a
                  >
                </li>
              </ul>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
