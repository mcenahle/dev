---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
const { frontmatter } = Astro.props;
---

<meta charset="utf-8" />
<Layout>
  <div class="usa-section" style="padding-top: 2rem; padding-bottom: 0rem;">
    <div class="grid-container">
      <div class="grid-row grid-gap">
        <div
          class="usa-layout-docs__sidenav display-none desktop:display-block desktop:grid-col-3"
        >
          <nav aria-label="Secondary navigation">
            <ul class="usa-sidenav" style="text-indent: 0em;">
              <li class="usa-sidenav__item">
                <a href="/">主页</a>
              </li>
              <li class="usa-sidenav__item">
                <a href="/posts/" class="usa-current">开发博客</a>
                <ul class="usa-sidenav__sublist">
                  <li class="usa-sidenav__item">
                    <a href="javascript:void(0);" class="usa-current"
                      >{frontmatter.title}</a
                    >
                  </li>
                </ul>
              </li>
            </ul>
          </nav>
        </div>
        <main class="desktop:grid-col-9 usa-prose" id="main-content">
          <h2 style="text-align: center; font-size: 30px;">
            {frontmatter.title}
          </h2>

          <div class="title-divider">
            <span></span>
          </div>

          <div class="post-meta">
            <span>
              <Icon name="mdi:account-edit" />
              {frontmatter.author}
            </span>

            <span>
              <Icon name="mdi:calendar" />
              {frontmatter.pubDate}
            </span>
            <div
              class="usa-prose posts"
              style="text-indent: 2em; margin-top: 10px; font-family: 'MN Source Han Serif SC', serif;"
            >
              <slot />
            </div>
          </div>
        </main>
      </div>
      <div class="usa-layout-docs__sidenav desktop:display-none">
        <nav aria-label="Secondary navigation">
          <ul class="usa-sidenav" style="text-indent: 0em;">
            <li class="usa-sidenav__item">
              <a href="/">主页</a>
            </li>
            <li class="usa-sidenav__item">
              <a href="/posts/" class="usa-current">开发博客</a>
              <ul class="usa-sidenav__sublist">
                <li class="usa-sidenav__item">
                  <a href="javascript:void(0);" class="usa-current"
                    >{frontmatter.title}</a
                  >
                </li>
              </ul>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
  <!-- <nav
    class="usa-breadcrumb"
    aria-label="Breadcrumbs,,"
    style="background-color: transparent;"
  >
    <ol class="usa-breadcrumb__list">
      <li class="usa-breadcrumb__list-item">
        <a href="/" class="usa-breadcrumb__link usa-link"><span>主页</span></a>
      </li>
      <li class="usa-breadcrumb__list-item">
        <a href="/posts/" class="usa-breadcrumb__link usa-link"
          ><span>开发博客</span></a
        >
      </li>
      <li class="usa-breadcrumb__list-item usa-current" aria-current="page">
        <span>{frontmatter.title}</span>
      </li>
    </ol>
  </nav>

  <h2 style="text-align: center; font-size: 30px;">{frontmatter.title}</h2>

  <div class="title-divider">
    <span></span>
  </div>

  <div class="post-meta">
    <span>
      <Icon name="mdi:account-edit" />
      {frontmatter.author}
    </span>

    <span>
      <Icon name="mdi:calendar" />
      {frontmatter.pubDate}
    </span>
  </div>

  <div class="posts" style="text-indent: 2em; margin-top: 10px;">
    <slot />
  </div> -->
  <hr style="margin-top: 24px;" />

  <ul class="usa-button-group">
    <li class="usa-button-group__item">
      <a href="/" class="usa-button usa-button--outline"
        ><Icon name="mdi:arrow-left" /> 返回首页</a
      >
    </li>
    <li class="usa-button-group__item">
      <button id="ask-gpt" type="button" class="usa-button"
        ><Icon name="bi:openai" /> 询问 ChatGPT</button
      >
    </li>
  </ul>

  <script>
    document.querySelector("#ask-gpt")?.addEventListener("click", () => {
      const pageUrl = window.location.href;
      const prompt = `阅读 ${pageUrl}，然后回答这个问题：`;
      const url = `https://chatgpt.com/?prompt=${encodeURIComponent(prompt)}`;

      window.open(url, "_blank");
    });
  </script>
</Layout>
