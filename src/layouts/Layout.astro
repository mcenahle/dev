---
import Banner from "../components/Banner.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../styles/global.scss";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="https://mcenahle.dev/favicon.svg"
    />
    <link rel="icon" href="https://mcenahle.dev/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>usdws.mcenahle.dev</title>
    <link rel="stylesheet" href="/uswds/css/styles.css" />
  </head>
  <body>
    <div class="site-wrapper">
      <Banner />
      <Header />

      <main class="site-main">
        <div class="grid-container">
          <slot />
        </div>
      </main>

      <Footer />
    </div>
  </body>
  <script is:inline src="/uswds/js/uswds.min.js"></script>
</html>
