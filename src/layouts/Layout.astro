---
import Banner from "../components/Banner.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../styles/global.scss";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>mcenahle.dev</title>
    <link rel="stylesheet" href="/uswds/css/styles.css" />

    <link rel="stylesheet" href="/highlightjs/styles/tokyo-night-dark.css" />
    <script is:inline src="/highlightjs/highlight.min.js"></script>
  </head>
  <body>
    <div class="site-wrapper">
      <Banner />
      <Header />

      <main class="site-main">
        <div class="grid-container">
          <div class="article">
            <slot />
          </div>
        </div>
      </main>

      <Footer />
    </div>

    <script>
      declare const hljs: {
        highlightAll(): void;
      };

      hljs.highlightAll();
    </script>
  </body>
  <script is:inline src="/uswds/js/uswds.min.js"></script>
</html>
